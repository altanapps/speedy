# Copy this file to .env and fill in your values. Never commit .env.
#
# OPENAI_API_KEY: required for refresh + /search. Embeddings cost ~$0.10
# for the first index build (~5–20k Polymarket markets) and pennies/month
# thereafter. Get one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# ANTHROPIC_API_KEY: optional. When set, /search runs LLM rerank with
# claude-haiku-4-5 over the top-K pgvector candidates — much better
# disambiguation on ambiguous queries ("Powell"). Without it, /search falls
# back to embedding-only top-1 with the cosine-similarity threshold.
# Cost: ~$0.001 per /search call. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# DATABASE_URL: optional override. Defaults to the local-dev value used by
# the Makefile (postgresql+asyncpg://speedy:speedy@localhost:5432/speedy).
# DATABASE_URL=

# SPEEDY_SEARCH_THRESHOLD: cosine similarity floor for /search top-1 match.
# Default 0.55. Lower (e.g. 0.45) for more matches at the cost of false
# positives; higher for stricter matching.
# SPEEDY_SEARCH_THRESHOLD=0.55

# === Trading (POST /order) ==================================================
# All four below are read together. Without POLYMARKET_PRIVATE_KEY, /order
# returns 503 and the rest of the app keeps working.
#
# POLYMARKET_PRIVATE_KEY: hex private key (with or without 0x prefix) of the
# wallet that will sign your orders. Get it from polymarket.com:
#     wallet (top right) → Settings → Export Private Key
# This key signs orders only — funds live in your proxy wallet (the funder).
# NEVER COMMIT THIS. NEVER PASTE IT IN A SHARED CHAT. Anyone with this key
# can drain the proxy wallet's USDC.
POLYMARKET_PRIVATE_KEY=
#
# POLYMARKET_FUNDER_ADDRESS: the proxy contract that holds your USDC. Visible
# on polymarket.com under "Deposit" — it's the address you'd send USDC to.
# Required when POLYMARKET_SIGNATURE_TYPE != 0.
POLYMARKET_FUNDER_ADDRESS=
#
# POLYMARKET_SIGNATURE_TYPE: which Polymarket auth scheme your account uses.
#   1 = email/Magic-style proxy wallet (default; this is what polymarket.com
#       creates for you when you sign up with email).
#   2 = browser-wallet proxy (web3-onboard / MetaMask through the proxy).
#   0 = self-custody EOA (the signer key directly holds USDC). Rare.
# Leave unset to default to 1.
# POLYMARKET_SIGNATURE_TYPE=1
#
# POLYMARKET_CLOB_HOST: override the CLOB endpoint. You almost certainly
# don't want to set this. Defaults to https://clob.polymarket.com.
# POLYMARKET_CLOB_HOST=
