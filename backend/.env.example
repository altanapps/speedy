# Copy this file to .env and fill in your values. Never commit .env.
#
# OPENAI_API_KEY: required for refresh + /search. Embeddings cost ~$0.10
# for the first index build (~5–20k Polymarket markets) and pennies/month
# thereafter. Get one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# ANTHROPIC_API_KEY: optional. When set, /search runs LLM rerank with
# claude-haiku-4-5 over the top-K pgvector candidates — much better
# disambiguation on ambiguous queries ("Powell"). Without it, /search falls
# back to embedding-only top-1 with the cosine-similarity threshold.
# Cost: ~$0.001 per /search call. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# DATABASE_URL: optional override. Defaults to the local-dev value used by
# the Makefile (postgresql+asyncpg://speedy:speedy@localhost:5432/speedy).
# DATABASE_URL=

# SPEEDY_SEARCH_THRESHOLD: cosine similarity floor for /search top-1 match.
# Default 0.55. Lower (e.g. 0.45) for more matches at the cost of false
# positives; higher for stricter matching.
# SPEEDY_SEARCH_THRESHOLD=0.55
